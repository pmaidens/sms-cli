# Copy to .env. Existing process environment variables take precedence.
# Use a remote libsql:// URL and token when deploying to Vercel.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your SMS-capable Twilio number in E.164 format, for example +12025550123.
TWILIO_PHONE_NUMBER=
# Stable production origin, no path or trailing slash.
WEBHOOK_BASE_URL=

# Deployment only. Set these to link to your own Vercel project and account.
# Leave both blank to use an existing local .vercel/project.json link.
VERCEL_PROJECT_NAME=
# Optional team/account slug or ID. Uses the CLI's default account if blank.
VERCEL_SCOPE=
